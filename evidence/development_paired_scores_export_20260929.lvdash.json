{
  "datasets": [
    {
      "name": "development_series",
      "displayName": "Verified 2021–2024 development series",
      "queryLines": [
        "SELECT borough, problem_family, COUNT(*) AS observed_days, SUM(y) AS requests, SUM(CAST(is_zero_filled AS INT)) AS zero_filled_days FROM daily_requests WHERE snapshot_id = 'development-silver-20260929' GROUP BY borough, problem_family ORDER BY requests DESC"
      ],
      "catalog": "mlops_dev",
      "schema": "nyc311_forecast"
    },
    {
      "name": "data_quality",
      "displayName": "Reconciled source and selected-series quality",
      "queryLines": [
        "SELECT snapshot_id, data_kind, expected_partitions, observed_partitions, reconciled_partitions, request_count, series_days, zero_filled_days FROM v_data_quality WHERE snapshot_id IN ('selection-2021-2023-20260929', 'development-2024-20260929', 'development-silver-20260929') ORDER BY snapshot_id, data_kind"
      ],
      "catalog": "mlops_dev",
      "schema": "nyc311_forecast"
    },
    {
      "name": "development_diagnostics",
      "displayName": "Partial 2024 two-model development cell coverage",
      "queryLines": [
        "WITH expected AS (SELECT model_id, origin, COUNT(DISTINCT series_id) AS expected_cells FROM forecast_attempts WHERE run_id = 'development-two-model-30862cc33ddc' AND model_id IN ('snaive7', 'prophet_tuned') AND origin IN (DATE '2024-10-31', DATE '2024-11-30') GROUP BY model_id, origin), scored AS (SELECT model_id, origin, COUNT(DISTINCT series_id) AS complete_cells FROM evaluation_cells WHERE run_id = 'development-two-model-30862cc33ddc' AND horizon_days = 28 AND paired_status = 'complete_two_model_development' AND n_expected = 28 AND n_actual = 28 AND n_predictions = 28 GROUP BY model_id, origin) SELECT r.run_id, r.status AS run_status, CAST(e.origin AS STRING) AS origin, e.model_id, e.expected_cells, COALESCE(s.complete_cells, 0) AS complete_cells, e.expected_cells - COALESCE(s.complete_cells, 0) AS incomplete_cells FROM expected e LEFT JOIN scored s ON s.model_id = e.model_id AND s.origin = e.origin JOIN forecast_runs r ON r.run_id = 'development-two-model-30862cc33ddc' AND r.status = 'partial_two_model_development_not_benchmark' ORDER BY e.origin, e.model_id"
      ],
      "catalog": "mlops_dev",
      "schema": "nyc311_forecast"
    },
    {
      "name": "development_paired_scores",
      "displayName": "Verified paired 2024 two-model score sums",
      "queryLines": [
        "WITH run_scope AS (SELECT run_id, status FROM forecast_runs WHERE run_id = 'development-two-model-30862cc33ddc' AND status = 'partial_two_model_development_not_benchmark'), complete AS (SELECT ec.* FROM evaluation_cells ec JOIN run_scope r ON ec.run_id = r.run_id WHERE ec.horizon_days = 28 AND ec.paired_status = 'complete_two_model_development' AND ec.n_expected = 28 AND ec.n_actual = 28 AND ec.n_predictions = 28 AND ec.model_id IN ('snaive7', 'prophet_tuned') AND ec.origin IN (DATE '2024-10-31', DATE '2024-11-30')), paired AS (SELECT series_id, origin FROM complete GROUP BY series_id, origin HAVING COUNT(DISTINCT model_id) = 2) SELECT r.run_id, r.status AS run_status, c.model_id, COUNT(*) AS paired_cells, SUM(c.abs_error_sum) AS abs_error_sum, SUM(c.actual_sum) AS actual_sum, SUM(c.abs_error_sum) / NULLIF(SUM(c.actual_sum), 0) AS pooled_wape FROM complete c JOIN paired p ON p.series_id = c.series_id AND p.origin = c.origin CROSS JOIN run_scope r GROUP BY r.run_id, r.status, c.model_id ORDER BY c.model_id"
      ],
      "catalog": "mlops_dev",
      "schema": "nyc311_forecast"
    }
  ],
